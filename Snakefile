configfile: "defaults/config.yaml"

include: "rules/provision_metadata.smk"
include: "rules/sequence_counts.smk"
include: "rules/mlr_estimates.smk"
include: "rules/fitness_flux_analysis.smk"
include: "rules/forecast_analysis.smk"
include: "rules/mutation_counts.smk"
include: "rules/lineage_deltas_analysis.smk"

# Default target: variant frequencies + forecast accuracy only. The fitness-flux and
# lineage-delta (mutational) work is intentionally excluded from the default run on
# this branch; their rules remain runnable via `all_fitness_flux` / `all_lineage_deltas`.
# The needed clade MLR fits and sequence counts are pulled in transitively.
# Defined after the includes so it can reference the per-stage aggregator rules.
rule all:
    default_target: True
    input:
        rules.all_frequencies.input,
        rules.all_forecast_analysis.input,
        rules.all_similarity_analysis.input,

rule clean:
    """
    Remove everything the workflow generates so the repo can be rerun from
    scratch: the upstream sequence-counts/ and mlr-estimates/, the logs, the
    analysis results/, and the generated viz component data/ and meta.json.
    Leaves the provisioned raw metadata in data/ and the component source in
    viz/ in place.
    """
    shell:
        """
        rm -rf sequence-counts \
               mlr-estimates \
               logs \
               fitness-flux-analysis/results \
               lineage-deltas-analysis/results \
               viz/time-vs-fitness/data viz/time-vs-fitness/meta.json \
               viz/time-vs-frequency/data viz/time-vs-frequency/meta.json \
               viz/frequency-vs-fitness/data viz/frequency-vs-fitness/meta.json \
               viz/variance-vs-flux/data viz/variance-vs-flux/meta.json \
               viz/forecast-accuracy/data viz/forecast-accuracy/meta.json \
               viz/clade-distance/data viz/clade-distance/meta.json \
               viz/similarity-accuracy/data viz/similarity-accuracy/meta.json
        """

rule clean_analysis:
    """
    Remove only the analysis intermediates generated by the fitness-flux and
    lineage-deltas rules (the results/ tables and the generated viz component
    data/ and meta.json), leaving the upstream sequence-counts/ and
    mlr-estimates/ outputs intact.
    """
    shell:
        """
        rm -rf fitness-flux-analysis/results \
               lineage-deltas-analysis/results \
               logs/fitness_flux \
               logs/lineage_deltas \
               viz/time-vs-fitness/data viz/time-vs-fitness/meta.json \
               viz/time-vs-frequency/data viz/time-vs-frequency/meta.json \
               viz/frequency-vs-fitness/data viz/frequency-vs-fitness/meta.json \
               viz/variance-vs-flux/data viz/variance-vs-flux/meta.json \
               viz/forecast-accuracy/data viz/forecast-accuracy/meta.json \
               viz/clade-distance/data viz/clade-distance/meta.json \
               viz/similarity-accuracy/data viz/similarity-accuracy/meta.json
        """
